# Database - Azure Database for PostgreSQL Flexible Server (production)
# Get the connection string from Azure Portal:
# PostgreSQL Flexible Server > Connection strings > psql
DATABASE_URL="postgresql://user:password@server.postgres.database.azure.com:5432/kazikashi?sslmode=require"

# Local development with Docker PostgreSQL:
# docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=password -e POSTGRES_DB=kazikashi postgres:17
# DATABASE_URL="postgresql://postgres:password@localhost:5432/kazikashi"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-change-in-production"

# OAuth providers - fill in your own credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
